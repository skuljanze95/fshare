{
  "name": "@skuljanze/fshare",
  "version": "0.1.0",
  "description": "Share a local file or folder through a public download link, served from your own computer via Cloudflare Tunnel. Agent-friendly, zero dependencies.",
  "keywords": [
    "share",
    "file-sharing",
    "cloudflare",
    "cloudflared",
    "tunnel",
    "download",
    "cli",
    "ai-agent",
    "claude-code",
    "npx"
  ],
  "homepage": "https://github.com/skuljanze95/fshare#readme",
  "bugs": {
    "url": "https://github.com/skuljanze95/fshare/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skuljanze95/fshare.git"
  },
  "license": "MIT",
  "author": "Anže Škulj (https://github.com/skuljanze95)",
  "type": "module",
  "bin": {
    "fshare": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
